{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["es2019"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "eslint.config.js"],
  "exclude": ["node_modules", "dist", "build"]
}
